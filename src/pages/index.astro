---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { projects } from '../data/projects';
import { pad } from '../lib/format';
import { site, about } from '../data/site';
import { existsSync } from 'node:fs';
import ProjectsLine from '../components/ProjectsLine';
import LeadProject from '../components/LeadProject';
import IntroType from '../components/IntroType';

// Only show images that actually exist.
const hasPhoto = existsSync(`public${site.photo}`);

// About line. Each {n} becomes a project name that pops up its image on hover.
// Lines are Anthony's own, from the project pages on the current site.
const aboutLine =
  'I made {0}, a beach brand about the slow life, and {1}, a hard seltzer that got sucked into a 1940s cartoon. Everything else lives in {2} and {3}.';
const aboutTargets = projects.map((p) => ({
  text: p.title,
  imageUrl: p.image,
  linkUrl: `/work/${p.slug}`,
  altText: p.imageAlt,
}));

// Same order as the current site. The first project leads full-bleed; the rest are cards.
const [lead, ...rest] = projects;
---

<Base>
  <!-- ---------- Hero: same hierarchy as the current site ---------- -->
  <header class="hero" id="hero">
    <nav class="topnav" aria-label="Main">
      <a href="#work">Work</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>

    <!-- The ink name and rotating title are decorative; this is what screen readers get. -->
    <h1 class="sr-only">
      Anthony Wekwert. Graphic designer, brand designer, visual storyteller, creative problem-solver.
    </h1>
    <div class="ink">
      <IntroType client:load />
      <p class="pitch">
        I design brand guidelines, packaging, and visual systems that help ideas stand out.
      </p>
    </div>

    <div class="hero-foot">
      <p class="hero-name">Michigan State<br /><span>Creative Advertising, May 2027</span></p>
      <a class="down" href="#work">
        Selected work
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M8 2v11M3 8.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
      </a>
    </div>
  </header>

  <main>
    <!-- ---------- Work ---------- -->
    <section class="work" id="work" aria-labelledby="work-title">
      <div class="section-head">
        <h2 id="work-title">Selected work</h2>
        <a class="all" href="/work">View all work</a>
      </div>

      {
        lead && (
          <div class="lead-wrap">
            <LeadProject
              client:visible
              slug={lead.slug}
              title={lead.title}
              discipline={lead.discipline}
              image={lead.image}
              imageAlt={lead.imageAlt}
            />
          </div>
        )
      }

      <ol class="cards" start="2">
        {
          rest.map((p, i) => (
            <li class:list={['card', `card-${i + 1}`]}>
              <a href={`/work/${p.slug}`}>
                <div class:list={['fill', `tone-${p.tone}`]}>
                  <img src={p.image} alt={p.imageAlt} loading="lazy" />
                  <span class="label fill-no">{pad(i + 2)}</span>
                </div>
                <div class="meta">
                  <span class="name">{p.title}</span>
                  <span class="tag">{p.discipline}</span>
                  <p class="summary">{p.summary}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ---------- About: the current site's About page, at the bottom ---------- -->
    <section class="about" id="about" aria-labelledby="about-title">
      <div class="section-head">
        <h2 id="about-title">About</h2>
        <span class="label">East Lansing, Michigan</span>
      </div>

      <div class="about-top">
        <div class="about-copy">
          <p class="role">Anthony Wekwert, designer / art director</p>
          <ProjectsLine client:visible content={aboutLine} targets={aboutTargets} />
        </div>
        <figure class="portrait">
          {
            hasPhoto ? (
              <img src={site.photo} alt="Anthony Wekwert" width="480" height="600" />
            ) : (
              <span class="label">Photo</span>
            )
          }
        </figure>
      </div>

      <!-- Left: "Anthony is". Right: resume sections, dates right-aligned like the resume. -->
      <div class="about-body">
        <div class="is">
          <h3>Anthony is</h3>
          <ul>{about.is.map((line) => <li>{line}</li>)}</ul>
        </div>

        <div class="resume">
          {
            about.sections.map((sec) => (
              <section class="res">
                <h3>{sec.heading}</h3>
                <ul>
                  {sec.items.map((it) => (
                    <li>
                      <div>
                        <span class="res-name">{it.name}</span>
                        {it.detail && <span class="res-detail">{it.detail}</span>}
                      </div>
                      {it.when && <span class="label res-when">{it.when}</span>}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  /* ---------- Hero: Stipple Type, full screen ---------- */

  /*
    Nav band on top, the ink headline filling the middle (left-aligned, so the
    weight sits left and the right side stays open), name strip at the bottom.
  */
  .hero {
    position: relative;
    height: calc(100svh - 3.5rem);
    min-height: 34rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Tiers, top to bottom: label, name (biggest), label, title (medium), pitch (smallest). */
  .ink {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5) var(--gutter) var(--s-4);
  }
  .ink :global(.intro-type) {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .ink :global(.intro-label) {
    font-size: var(--t-lg);
    font-weight: var(--w-light);
    color: var(--ink-soft);
    line-height: var(--lh-tight);
  }
  .ink :global(.intro-ink) {
    flex: 1;
    min-height: 0;
    position: relative;
    margin-left: calc(var(--gutter) * -0.5);
  }
  .ink :global(.intro-label + .intro-ink + .intro-label) {
    margin-top: var(--s-2);
  }

  .ink :global(.intro-title) {
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    font-weight: var(--w-heavy);
    line-height: 1.05;
    letter-spacing: -0.02em;
    overflow: hidden;
  }
  /* Each new title slides up into place. Same move every time, short and quiet. */
  .ink :global(.intro-title-word) {
    display: inline-block;
    animation: title-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes title-in {
    from {
      transform: translateY(0.6em);
      opacity: 0;
    }
  }

  .pitch {
    font-size: var(--t-sm);
    color: var(--ink-soft);
    max-width: 44ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .ink :global(.intro-title-word) {
      animation: none;
    }
  }

  /* Solid navy bands top and bottom, like the clear strip on the banner. Flat, no blur. */
  .topnav {
    display: flex;
    justify-content: flex-end;
    gap: var(--s-4);
    padding: var(--s-3) var(--gutter);
    background: var(--navy);
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-soft);
  }
  .topnav a:hover {
    color: var(--cream);
    text-decoration-line: underline;
  }

  /* Banner's bottom strip: name left, the way down on the right, hairline above. */
  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-4);
    padding: var(--s-3) var(--gutter) var(--gutter);
    background: var(--navy);
    border-top: 1px solid var(--rule);
  }

  .hero-name {
    font-size: var(--t-md);
    font-weight: var(--w-heavy);
    line-height: var(--lh-tight);
  }
  .hero-name span {
    color: var(--ink-soft);
    font-weight: var(--w-regular);
  }

  .down {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-sm);
    font-weight: var(--w-heavy);
    white-space: nowrap;
  }

  /* Red as an underline only. Red text on navy is too dark to read. */
  .down:hover,
  .all:hover,
  .card a:hover .name {
    text-decoration-line: underline;
  }

  /* ---------- Shared section head ---------- */

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--s-2);
    margin-bottom: var(--s-4);
  }

  .section-head h2 {
    font-size: var(--t-lg);
    font-weight: var(--w-heavy);
    line-height: var(--lh-tight);
  }

  .all {
    font-size: var(--t-sm);
    font-weight: var(--w-heavy);
  }

  /* ---------- Work cards ---------- */

  .work {
    padding: var(--s-5) var(--gutter) var(--s-7);
  }

  /* Uneven on purpose: 7 + 5 on top, a wide one under that bleeds right. */
  .cards {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--s-4);
    row-gap: var(--s-6);
  }

  .card a {
    display: block;
  }

  .card-1 {
    grid-column: 1 / span 7;
  }
  .card-2 {
    grid-column: 8 / -1;
  }
  .card-3 {
    grid-column: 4 / -1;
    margin-right: calc(var(--gutter) * -1);
  }
  .card-3 .meta {
    padding-right: var(--gutter);
  }

  .fill {
    position: relative;
    overflow: hidden;
    height: clamp(16rem, 34vw, 34rem);
  }
  .card-3 .fill {
    height: clamp(14rem, 26vw, 26rem);
  }

  .tone-red {
    background: var(--red);
    color: var(--cream);
  }
  .tone-cream {
    background: var(--cream);
    color: var(--navy);
  }
  .tone-deep {
    background: var(--navy-lift);
    color: var(--cream);
  }

  .fill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .card a:hover .fill img {
    transform: scale(1.03);
  }

  /* Number sits on a small navy block so it reads on any image. */
  .fill-no {
    position: absolute;
    top: 0;
    left: 0;
    padding: var(--s-1) var(--s-2);
    background: var(--navy);
    color: var(--cream);
  }


  .meta {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: var(--s-2) var(--s-3);
    align-items: baseline;
    padding-top: var(--s-3);
  }

  .name {
    font-size: var(--t-md);
    font-weight: var(--w-heavy);
    line-height: var(--lh-tight);
    text-decoration-thickness: 0.12em;
  }

  .tag {
    justify-self: start;
    font-size: var(--t-xs);
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
  }

  .summary {
    justify-self: end;
    text-align: right;
    font-size: var(--t-sm);
    font-style: italic;
    font-weight: var(--w-light);
    color: var(--ink-soft);
    max-width: 34ch;
  }

  /* ---------- About: bottom of the page ---------- */

  .about {
    padding: var(--s-5) var(--gutter) var(--s-7);
  }

  /* Line packed on the left, photo small on the right, air between. */
  .about-top {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--s-4);
    align-items: end;
    padding: var(--s-5) 0 var(--s-6);
  }

  .about-copy {
    grid-column: 1 / span 8;
    display: grid;
    gap: var(--s-4);
  }

  .role {
    font-size: var(--t-sm);
    font-weight: var(--w-heavy);
    color: var(--ink-soft);
  }

  .about :global(.projects-line) {
    font-size: clamp(1.75rem, 1rem + 2.6vw, 3.5rem);
    font-weight: var(--w-light);
    line-height: 1.15;
    letter-spacing: -0.015em;
    max-width: 30ch;
    text-wrap: pretty;
  }

  .portrait {
    grid-column: 10 / -1;
    margin: 0;
    aspect-ratio: 4 / 5;
    background: var(--navy-lift);
    display: grid;
    place-items: end start;
    overflow: hidden;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portrait .label {
    padding: var(--s-2);
  }

  /* "Anthony is" on the left, resume sections packed on the right. */
  .about-body {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--s-4);
    align-items: start;
    border-top: 1px solid var(--rule);
    padding-top: var(--s-4);
  }

  .about-body h3 {
    font-size: var(--t-md);
    font-weight: var(--w-heavy);
    line-height: var(--lh-tight);
    margin-bottom: var(--s-3);
  }

  .is {
    grid-column: 1 / span 5;
  }
  .is li {
    font-size: var(--t-md);
    font-weight: var(--w-light);
    line-height: 1.35;
  }

  .resume {
    grid-column: 7 / -1;
    display: grid;
    gap: var(--s-5);
  }
  .res h3 {
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--rule);
  }
  .res ul {
    display: grid;
    gap: var(--s-3);
  }
  /* Like the resume: name bold, detail under it, date right-aligned on the name's baseline. */
  .res li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
  }
  .res li > div {
    display: grid;
    gap: 0.1rem;
  }
  .res-name {
    font-size: var(--t-sm);
    font-weight: var(--w-heavy);
  }
  .res-detail {
    font-size: var(--t-sm);
    color: var(--ink-soft);
  }
  .res-when {
    white-space: nowrap;
  }

  /* ---------- Lead project ---------- */

  /* Full bleed: cancels the section gutter so the frame runs edge to edge. */
  .lead-wrap {
    margin: 0 calc(var(--gutter) * -1) var(--s-6);
  }

  /* ---------- Small screens ---------- */

  @media (max-width: 760px) {
    .hero-foot {
      flex-direction: column;
      align-items: start;
    }

    /* Ink box only as tall as two lines, so the headline sits right under its label. */
    .ink {
      padding-top: var(--s-6);
    }
    .ink :global(.intro-ink) {
      flex: 0 0 auto;
      height: 50vw;
    }
    .ink :global(.intro-type) {
      flex: 0 0 auto;
    }

    .work {
      padding-top: var(--s-4);
      padding-bottom: var(--s-6);
    }

    .cards {
      grid-template-columns: 1fr;
      row-gap: var(--s-5);
    }
    .card-1,
    .card-2,
    .card-3 {
      grid-column: 1;
    }
    .fill,
    .card-3 .fill {
      height: 62vw;
    }

    .meta {
      grid-template-columns: auto 1fr;
    }
    .summary {
      grid-column: 1 / -1;
      justify-self: start;
      text-align: left;
    }

    .about-top {
      grid-template-columns: 1fr 6.5rem;
      gap: var(--s-3);
    }
    /* Photo tucks into the top-right corner, the line runs full width under it. */
    .about-copy {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .portrait {
      grid-column: 2;
      grid-row: 1;
    }

    .about-body {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
    .is,
    .resume {
      grid-column: 1;
    }
    .res li {
      flex-direction: column;
      gap: 0.1rem;
    }
  }
</style>
