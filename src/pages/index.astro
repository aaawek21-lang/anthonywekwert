---
// Landing page, built with tasteskill 2.5 (.taste-skill/plan.md has the plan and the deal).
// The kit lives in public/assets and loads as plain files; Astro only resizes the images.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projects } from '../data/projects';
import Kit from '../layouts/Kit.astro';
import { workImage } from '../lib/images';
import stripe from '../assets/stock/white-wall-red-stripe.jpg';

// One <img> with a WebP srcset at the given widths.
async function pic(meta: ImageMetadata, widths: number[]) {
  const sizes = widths.filter((w) => w <= meta.width);
  const out = await Promise.all(sizes.map((w) => getImage({ src: meta, width: w, format: 'webp', quality: 80 })));
  return {
    src: out[out.length - 1].src,
    srcset: out.map((o, i) => `${o.src} ${sizes[i]}w`).join(', '),
    width: meta.width,
    height: meta.height,
  };
}

const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));
const vita = bySlug['vita-lenta'];
const toonz = bySlug['twisted-toonz'];
const lumina = bySlug['lumina'];

const hero = await pic(workImage(vita.image), [640, 960, 1280, 1600]);
const steps = [
  {
    p: vita,
    title: 'Vita Lenta, a beach brand',
    line: 'A spec brand for a beach about slowing down: the logo, line-art botanicals and cups in dark red, black and cream.',
    img: await pic(workImage('/work/vita-lenta/slide-14.jpg'), [640, 960, 1280, 1800]),
    alt: 'Vita Lenta brand slide with the logo and botanical marks',
  },
  {
    p: toonz,
    title: 'Twisted Toonz, a hard seltzer',
    line: 'What happens when a hard seltzer gets sucked into a 1940s cartoon? Three flavors, three cans, a character on each.',
    img: await pic(workImage(toonz.image), [640, 960, 1280, 1600]),
    alt: toonz.imageAlt,
  },
  {
    p: lumina,
    title: 'Lumina, a transit map',
    line: 'A network map with colored lines, stops and a legend, drawn to read at a glance.',
    img: await pic(workImage(lumina.image), [640, 960, 1280, 1800]),
    alt: lumina.imageAlt,
    // the map's title and legend sit at its left edge: keep them in the crop
    pos: '0% 50%',
  },
];

const studies = await Promise.all(
  [
    ['/work/design-studies/asp-logo.jpg', 'Phoenix logo', 'Alpha Sigma Phi MSU phoenix logo'],
    ['/work/design-studies/sanuk.jpg', 'Sanuk poster', 'Sanuk poster'],
    ['/work/design-studies/fall-26-rush.jpg', 'Rush graphic', 'Alpha Sigma Phi fall 2026 rush graphic'],
    ['/work/photography/img-2661.jpg', 'Jeep at dusk', 'Red Jeep Wrangler at dusk'],
  ].map(async ([path, name, alt]) => ({ name, alt, img: await pic(workImage(path), [400, 640, 960, 1200]) })),
);

const about = await pic(stripe, [640, 960, 1280, 1600]);
const close = await pic(workImage('/work/vita-lenta/slide-12.jpg'), [640, 960, 1280, 1800]);

const title = 'Anthony Wekwert: designer and art director in East Lansing';
const description =
  'Portfolio of Anthony Wekwert: Vita Lenta, a beach brand; Twisted Toonz, hard seltzer packaging; and Lumina, a transit map. Michigan State, graduating May 2027.';
---

<Kit title={title} description={description} ogDescription="Brand identity, packaging and a transit map by Anthony Wekwert, Michigan State, May 2027." home moments={['pinned-chapters']}>
<style is:inline slot="head">
/* page CSS: the studies wall (sections-library: a picture wall is its own grid, gap 2px, line to line) */
.wall { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2px; border-radius: var(--r-lg); overflow: clip; }
.wall > a { display: block; aspect-ratio: 1; }
.wall img { width: 100%; height: 100%; object-fit: cover; }
#about .frame--photo { --ratio: 88%; }
@media (max-width: 639px) { .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); } .wall > a { aspect-ratio: 4 / 5; } }
/* the tablet keeps each section on one screen (layout-v4.md, the tablet table): wider step pictures in
   the resting rows of the work section, a shorter frame for the about photograph */
@media (min-width: 640px) and (max-width: 1023px) {
  #work:not(.is-live) .mo-pc__visual > img { aspect-ratio: 2 / 1; }
  #about .frame--photo { --ratio: 40%; }
  .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .wall > a { aspect-ratio: 10 / 9; }
}
/* a phone: the work section rests as stacked steps over exactly two screens, its pictures at 6:5 so the
   second screen is filled; the about section stays one screen with its photograph as a short strip */
@media (max-width: 639px) {
  main > #work[data-moment]:not(.is-live) { min-height: calc(2 * 100lvh); }
  #work:not(.is-live) .mo-pc__visual > img { aspect-ratio: 6 / 5; max-height: none; }
  #about .frame--photo { --ratio: 28%; }
  #about .frame__img { object-position: 50% 80%; }
}
</style>
<Fragment slot="deal">
<!-- type: service
     deal: hero split, nav nav-centre, close close-photo, footer footer-dark (footer-visit re-dealt: no door),
     rhythm space, buttons arrow, mark initial, grounds none; palette: the client's own (start.mjs brand), pairing host
     moments: pinned-chapters in #work (the three projects, one frame changing per project) -->
</Fragment>

  <section class="hero hero--split" data-enter aria-labelledby="hero-h">
    <div class="wrap"><div class="hero-text grid hero__grid">
      <div class="hero__text span-5">
        <p class="hero__kicker"><span class="dot" aria-hidden="true"></span>Hi, I'm Anthony Wekwert</p>
        <h1 id="hero-h">Designer and art director in East Lansing</h1>
        <p class="hero__lead">I design brand guidelines, packaging and visual systems that help ideas stand out. Creative Advertising at Michigan State, graduating May 2027.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="#work">See the work<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
          <a class="btn btn--secondary" href="/about">Read about me</a>
        </div>
      </div>
      <div class="hero__media span-6 start-7">
        <img src={hero.src} srcset={hero.srcset} sizes="(max-width: 1023px) 100vw, 66vw" width={hero.width} height={hero.height} alt={vita.imageAlt} style="--ly-pos: 50% 50%" fetchpriority="high" data-source="client" data-subject="Vita Lenta packaging">
        <div class="ly-float">
          <div class="ly-float__row"><span class="ly-live">Open to work</span><span>May 2027</span></div>
          <div class="ly-float__title">Full-time design and art direction roles</div>
        </div>
      </div>
    </div></div>
  </section>

  <!-- pinned-chapters (references/moments.md): the section holds for two screens while the three projects
       open one at a time; the frame on the right changes to each project's picture -->
  <section class="section" id="work" style="--h: 2" data-moment="pinned-chapters" aria-labelledby="work-h">
    <div class="wrap mo-pc__grid">
      <div class="mo-pc__text">
        <h2 id="work-h">Selected work. <span class="muted">Three spec projects.</span></h2>
        <ol class="mo-pc__steps">
          {steps.map((s) => (
            <li class="mo-pc__step">
              <h3><a href={`/work/${s.p.slug}`}>{s.title}</a></h3>
              <p>{s.line}</p>
              <figure class="mo-pc__visual">
                <img src={s.img.src} srcset={s.img.srcset} sizes="(max-width: 639px) 100vw, 50vw" width={s.img.width} height={s.img.height} alt={s.alt} style={s.pos ? `object-position: ${s.pos}` : undefined} loading="lazy" decoding="async" data-source="client" data-subject={`${s.p.title} project`}>
              </figure>
            </li>
          ))}
        </ol>
        <p><a class="link" href="/work">See every project</a></p>
      </div>
      <div class="mo-pc__visuals frame"></div>
    </div>
  </section>

  <section class="section" id="studies" aria-labelledby="studies-h">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div>
          <h2 id="studies-h">Design studies and photos</h2>
          <p>Logos, posters, flyers and photographs from the past year.</p>
        </div>
        <a class="link" href="/work/design-studies">See design studies</a>
      </div>
      <div class="wall">
        {studies.map((s) => (
          <a class="m-zoom" href="/work/design-studies" aria-label={`${s.alt}, in Design Studies`}>
            <img src={s.img.src} srcset={s.img.srcset} sizes="(max-width: 1023px) 50vw, 25vw" width={s.img.width} height={s.img.height} alt={s.alt} loading="lazy" decoding="async" data-source="client" data-subject="design study">
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-h">
    <div class="wrap grid grid--top">
      <div class="span-5">
        <div class="section-head">
          <h2 id="about-h">About me</h2>
          <p>I study Creative Advertising and design brands, packaging and the systems that hold them together.</p>
        </div>
        <ul class="rows">
          <li><span class="rows__name">Michigan State University<small>BA Creative Advertising, graduating May 2027</small></span></li>
          <li><span class="rows__name">Alpha Sigma Phi, MSU<small>Brand and social media director</small></span></li>
          <li><span class="rows__name">Addy Awards, AAF<small>Silver and Bronze, February 2026</small></span></li>
          <li><span class="rows__name">Harper's Brew and Pub<small>DJ for crowds of 500 and more</small></span></li>
        </ul>
        <p class="about__more"><a class="link" href="/about">Read about me</a></p>
      </div>
      <div class="frame frame--photo span-6 start-7">
        <img class="frame__img" src={about.src} srcset={about.srcset} sizes="(max-width: 1023px) 100vw, 50vw" width={about.width} height={about.height} alt="A white wall with a red stripe against a deep blue sky" loading="lazy" decoding="async" data-source="stand-in" data-subject="abstract architecture">
      </div>
    </div>
  </section>
  <Fragment slot="close">
    <div class="closing__cta close--photo">
      <div class="section-head--split">
        <div><h2 id="close-h">Full-time roles from May 2027</h2><p class="t-lead">Looking for a design or art direction job after graduation.</p></div>
        <a class="btn btn--primary" href="#work">See the work<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
      </div>
      <div class="close__media"><img src={close.src} srcset={close.srcset} sizes="(max-width: 639px) 220vw, 100vw" width={close.width} height={close.height} alt="Vita Lenta brand slide" loading="lazy" decoding="async" data-source="client" data-subject="Vita Lenta brand"></div>
    </div>
  </Fragment>
</Kit>
