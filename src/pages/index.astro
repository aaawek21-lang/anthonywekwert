---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { projects } from '../data/projects';
import { pad } from '../lib/format';

// Placeholder about content. Swap for real numbers and quotes from the resume.
const stats = [
  { value: '0X', label: 'Years designing' },
  { value: '00', label: 'Projects shipped' },
  { value: '00', label: 'Awards' },
];

const reviews = [
  {
    quote:
      'Placeholder review. Two or three sentences from a teammate on what it was like to work with Anthony.',
    name: 'Teammate name',
    role: 'Role, team or company',
  },
  {
    quote: 'Placeholder review. A shorter one works here. Specific beats glowing.',
    name: 'Teammate name',
    role: 'Role, team or company',
  },
  {
    quote:
      'Placeholder review. Pick quotes that name a real thing he did, not just that he was great.',
    name: 'Teammate name',
    role: 'Role, team or company',
  },
];
---

<Base>
  <!-- ---------- Hero ---------- -->
  <!--
    Full-bleed frame: the active project fills the whole screen, edge to edge.
    The bar at the bottom switches projects. Without JS, the first project shows.
  -->
  <header
    class="hero"
    data-tone={projects[0].tone}
    data-slugs={JSON.stringify(projects.map((p) => p.slug))}
    data-tones={JSON.stringify(projects.map((p) => p.tone))}
  >
    <div class="slides">
      {
        projects.map((p, i) => (
          <div
            class:list={['slide', `tone-${p.tone}`]}
            data-slide={i}
            data-active={i === 0 ? '' : undefined}
          >
            {p.image ? (
              <img src={p.image} alt={p.imageAlt ?? ''} loading={i === 0 ? 'eager' : 'lazy'} />
            ) : (
              <span class="label slide-note">{p.title}: full-bleed image goes here</span>
            )}
          </div>
        ))
      }
    </div>

    <h1 class="mega" aria-label="Anthony Wekwert">
      <span aria-hidden="true">Wekwert</span>
    </h1>

    <div class="strip">
      <p class="who">Anthony Wekwert<br />Senior design student, Michigan State</p>

      <div class="intro">
        <p>Placeholder intro. One sentence on what Anthony makes and who for.</p>
        <nav aria-label="Main">
          <a href="#work">Work</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </div>

    <!-- Bottom bar: switcher, spec cells, one call to action. Flat, square, no blur. -->
    <div class="bar">
      <div class="switch" role="group" aria-label="Featured project">
        {
          projects.map((p, i) => (
            <button type="button" data-pick={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class:list={['swatch', `tone-${p.tone}`]} aria-hidden="true">
                {p.image && <img src={p.image} alt="" />}
              </span>
              {p.title}
            </button>
          ))
        }
      </div>

      {
        projects.map((p, i) => (
          <dl class="spec" data-spec={i} hidden={i !== 0}>
            <div>
              <dt class="label">Discipline</dt>
              <dd>{p.discipline}</dd>
            </div>
            <div class="spec-role">
              <dt class="label">Role</dt>
              <dd>{p.role}</dd>
            </div>
            <div>
              <dt class="label">Year</dt>
              <dd>{p.year}</dd>
            </div>
          </dl>
        ))
      }

      <a class="go" href={`/work/${projects[0].slug}`} data-go>
        View project <span aria-hidden="true">→</span>
      </a>
    </div>
  </header>

  <script>
    const hero = document.querySelector<HTMLElement>('.hero');
    if (hero) {
      const slides = hero.querySelectorAll<HTMLElement>('[data-slide]');
      const specs = hero.querySelectorAll<HTMLElement>('[data-spec]');
      const picks = hero.querySelectorAll<HTMLButtonElement>('[data-pick]');
      const go = hero.querySelector<HTMLAnchorElement>('[data-go]');
      const slugs = JSON.parse(hero.dataset.slugs ?? '[]') as string[];
      const tones = JSON.parse(hero.dataset.tones ?? '[]') as string[];

      picks.forEach((btn) => {
        btn.addEventListener('click', () => {
          const n = Number(btn.dataset.pick);
          slides.forEach((s, i) => s.toggleAttribute('data-active', i === n));
          specs.forEach((s, i) => (s.hidden = i !== n));
          picks.forEach((b, i) => b.setAttribute('aria-pressed', String(i === n)));
          hero.dataset.tone = tones[n];
          if (go) go.href = `/work/${slugs[n]}`;
        });
      });
    }
  </script>

  <main>
    <!-- ---------- Work: starts inside the first screen ---------- -->
    <section class="work" id="work" aria-labelledby="work-title">
      <div class="section-head">
        <h2 id="work-title">Selected work</h2>
        <a class="all" href="/work">View all work</a>
      </div>

      <ol class="cards">
        {
          projects.map((p, i) => (
            <li class:list={['card', `card-${i + 1}`]}>
              <a href={`/work/${p.slug}`}>
                {/* Flat fill with the title cropped by the card edge. Real image goes here later. */}
                <div class:list={['fill', `tone-${p.tone}`]}>
                  <span class="label fill-no">{pad(i + 1)}</span>
                  <span class="fill-title" aria-hidden="true">
                    {p.title}
                  </span>
                </div>
                <div class="meta">
                  <span class="name">{p.title}</span>
                  <span class="tag">{p.discipline}</span>
                  <p class="summary">{p.summary}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ---------- About ---------- -->
    <section class="about" id="about" aria-labelledby="about-title">
      <div class="section-head">
        <h2 id="about-title">About</h2>
        <span class="label">Placeholder copy</span>
      </div>

      <p class="statement">
        Placeholder design philosophy. One line on how Anthony thinks about the work.
      </p>

      <div class="about-grid">
        <div class="philosophy">
          <p>
            Placeholder paragraph. A few short sentences on process: how a project starts,
            what he looks for, and what he won't do.
          </p>
          <p>
            Placeholder paragraph. Where he's headed next, and the kind of team he wants to
            join.
          </p>
        </div>

        <dl class="stats">
          {
            stats.map((s) => (
              <div>
                <dt class="label">{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="reviews">
        <h3 class="label">From teammates</h3>
        <ul>
          {
            reviews.map((r) => (
              <li>
                <blockquote>
                  <p>{r.quote}</p>
                </blockquote>
                <p class="who-said">
                  <span class="name-sm">{r.name}</span>
                  <span class="label">{r.role}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  /* ---------- Hero: the banner move ---------- */

  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100svh;
    min-height: 34rem;
    color: var(--cream);
    transition: color 0.3s ease;
  }
  /* Type flips to navy when the frame behind it is cream. */
  .hero[data-tone='cream'] {
    color: var(--navy);
  }

  /* ---------- Full-bleed frame ---------- */

  .slides {
    position: absolute;
    inset: 0;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .slide[data-active] {
    opacity: 1;
  }

  .slide img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .slide-note {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    color: inherit;
    opacity: 0.6;
  }

  .mega,
  .strip,
  .bar {
    position: relative;
  }

  /*
    The surname is set too big for the frame on purpose.
    Negative top margin pushes the cap height past the top edge,
    and the word runs past the right edge. No centering.
  */
  .mega {
    font-size: var(--t-mega);
    font-weight: var(--w-heavy);
    line-height: 0.7;
    letter-spacing: -0.045em;
    white-space: nowrap;
    margin-top: -0.06em;
    margin-left: -0.035em;
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--s-4);
    align-items: end;
    padding: var(--s-4) var(--gutter) var(--s-3);
  }

  .who {
    grid-column: 1 / span 4;
    font-size: var(--t-xs);
    line-height: 1.4;
    opacity: 0.75;
  }

  .intro {
    grid-column: 7 / span 4;
    display: grid;
    gap: var(--s-2);
    font-size: var(--t-sm);
    line-height: 1.45;
    max-width: 34ch;
  }

  .intro nav {
    display: flex;
    gap: var(--s-4);
    font-weight: var(--w-heavy);
  }

  /* ---------- Bottom bar ---------- */

  /*
    Sits inside the frame, inset by the gutter, so the image still runs
    to every edge around it. Solid navy, square corners, hairline dividers.
  */
  .bar {
    margin: auto var(--gutter) var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr auto;
    background: var(--navy);
    color: var(--cream);
    border: 1px solid var(--rule);
  }

  .switch {
    display: flex;
    border-right: 1px solid var(--rule);
  }

  .switch button {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-4) var(--s-3) var(--s-3);
    border: 0;
    border-right: 1px solid var(--rule);
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    font-size: var(--t-sm);
    font-weight: var(--w-heavy);
    white-space: nowrap;
    cursor: pointer;
  }
  .switch button:last-child {
    border-right: 0;
  }
  .switch button:hover {
    color: var(--cream);
  }
  .switch button[aria-pressed='true'] {
    background: var(--cream);
    color: var(--navy);
  }
  .switch button:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: -4px;
  }
  .switch button[aria-pressed='true']:focus-visible {
    outline-color: var(--navy);
  }

  /* Tiny square of the project: its image, or its tone fill. */
  .swatch {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    overflow: hidden;
    outline: 1px solid var(--rule);
  }
  .swatch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .spec {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
  }
  .spec[hidden] {
    display: none;
  }
  .spec div {
    padding: var(--s-2) var(--s-5) var(--s-2) var(--s-3);
    border-right: 1px solid var(--rule);
    display: grid;
    align-content: center;
  }
  .spec dd {
    margin: 0;
    font-size: var(--t-sm);
    font-weight: var(--w-heavy);
    line-height: var(--lh-tight);
  }

  /* The one solid call to action. Cream block, navy type. */
  .go {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0 var(--s-5);
    background: var(--cream);
    color: var(--navy);
    font-size: var(--t-sm);
    font-weight: var(--w-heavy);
    white-space: nowrap;
  }
  .go span {
    transition: transform 0.2s ease;
  }
  .go:hover span {
    transform: translateX(0.25rem);
  }
  .go:focus-visible {
    outline-offset: -4px;
    outline-color: var(--navy);
  }

  .spec dd {
    white-space: nowrap;
  }
  .spec {
    min-width: 0;
    overflow: hidden;
  }

  /* Laptop and tablet widths: drop the role cell and tighten padding. */
  @media (max-width: 1100px) {
    .spec-role {
      display: none !important;
    }
    .switch button {
      padding-right: var(--s-3);
    }
    .spec div {
      padding-right: var(--s-4);
    }
    .go {
      padding: 0 var(--s-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero,
    .slide,
    .go span {
      transition: none;
    }
  }

  /* Red as an underline only. Red text on navy is too dark to read. */
  .intro nav a:hover,
  .all:hover,
  .card a:hover .name {
    text-decoration-line: underline;
  }

  /* ---------- Shared section head ---------- */

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--s-2);
    margin-bottom: var(--s-4);
  }

  .section-head h2 {
    font-size: var(--t-lg);
    font-weight: var(--w-heavy);
    line-height: var(--lh-tight);
  }

  .all {
    font-size: var(--t-sm);
    font-weight: var(--w-heavy);
  }

  /* ---------- Work cards ---------- */

  .work {
    padding: var(--s-5) var(--gutter) var(--s-7);
  }

  /* Uneven on purpose: 7 + 5 on top, a wide one under that bleeds right. */
  .cards {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--s-4);
    row-gap: var(--s-6);
  }

  .card a {
    display: block;
  }

  .card-1 {
    grid-column: 1 / span 7;
  }
  .card-2 {
    grid-column: 8 / -1;
  }
  .card-3 {
    grid-column: 4 / -1;
    margin-right: calc(var(--gutter) * -1);
  }
  .card-3 .meta {
    padding-right: var(--gutter);
  }

  .fill {
    position: relative;
    overflow: hidden;
    height: clamp(16rem, 34vw, 34rem);
  }
  .card-3 .fill {
    height: clamp(14rem, 26vw, 26rem);
  }

  .tone-red {
    background: var(--red);
    color: var(--cream);
  }
  .tone-cream {
    background: var(--cream);
    color: var(--navy);
  }
  .tone-deep {
    background: var(--navy-lift);
    color: var(--cream);
  }

  .fill-no {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    color: inherit;
    opacity: 0.7;
  }

  /* The title runs off the bottom-right of its card. Same crop, smaller frame. */
  .fill-title {
    position: absolute;
    left: var(--s-3);
    bottom: -0.2em;
    font-size: clamp(4rem, 11vw, 11rem);
    font-weight: var(--w-heavy);
    line-height: 0.8;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .card-2 .fill-title {
    font-size: clamp(4rem, 9vw, 9rem);
  }

  .meta {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: var(--s-2) var(--s-3);
    align-items: baseline;
    padding-top: var(--s-3);
  }

  .name {
    font-size: var(--t-md);
    font-weight: var(--w-heavy);
    line-height: var(--lh-tight);
    text-decoration-thickness: 0.12em;
  }

  .tag {
    justify-self: start;
    font-size: var(--t-xs);
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
  }

  .summary {
    justify-self: end;
    text-align: right;
    font-size: var(--t-sm);
    font-style: italic;
    font-weight: var(--w-light);
    color: var(--ink-soft);
    max-width: 34ch;
  }

  /* ---------- About ---------- */

  .about {
    padding: 0 var(--gutter) var(--s-7);
  }

  /* The one italic moment, borrowed from the moodboard. Same typeface, no second font. */
  .statement {
    font-size: var(--t-xl);
    font-style: italic;
    font-weight: var(--w-light);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 18ch;
    margin: var(--s-6) 0 var(--s-7) auto;
    width: min(100%, 70%);
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--s-4);
    align-items: start;
    margin-bottom: var(--s-7);
  }

  .philosophy {
    grid-column: 1 / span 5;
    display: grid;
    gap: var(--s-3);
    color: var(--ink-soft);
    max-width: 46ch;
  }

  /* Stats packed tight on the right, open space on the left. */
  .stats {
    grid-column: 7 / -1;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
  }

  .stats div {
    border-top: 1px solid var(--rule);
    padding-top: var(--s-2);
    display: flex;
    flex-direction: column-reverse;
    gap: var(--s-1);
  }

  .stats dd {
    margin: 0;
    font-size: clamp(3rem, 2rem + 4vw, 6rem);
    font-weight: var(--w-heavy);
    line-height: 0.85;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .reviews h3 {
    margin-bottom: var(--s-3);
  }

  .reviews ul {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--s-4);
  }

  .reviews li {
    border-top: 1px solid var(--rule);
    padding-top: var(--s-3);
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  /* Uneven widths, the first quote leads. */
  .reviews li:nth-child(1) {
    grid-column: 1 / span 5;
  }
  .reviews li:nth-child(2) {
    grid-column: 6 / span 3;
  }
  .reviews li:nth-child(3) {
    grid-column: 9 / -1;
  }

  blockquote {
    margin: 0;
  }

  /* Red used as a flat mark, where it doesn't have to be read as text. */
  blockquote p::before {
    content: '“';
    display: block;
    color: var(--accent);
    font-size: 4rem;
    font-weight: var(--w-heavy);
    line-height: 0.6;
    margin-bottom: var(--s-2);
  }

  blockquote p {
    font-size: var(--t-md);
    line-height: 1.35;
  }
  .reviews li:nth-child(1) blockquote p {
    font-size: var(--t-lg);
    line-height: 1.2;
  }

  .who-said {
    display: grid;
    gap: 0.1rem;
  }

  .name-sm {
    font-size: var(--t-sm);
    font-weight: var(--w-heavy);
  }

  /* ---------- Small screens ---------- */

  @media (max-width: 760px) {
    /* On a phone the full word gets too thin. Go bigger and crop harder. */
    .mega {
      font-size: 34vw;
    }

    .strip {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--s-3);
    }
    .who {
      grid-column: 1;
    }
    .intro {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .who {
      grid-column: 1 / -1;
    }

    /* Bar stacks: switcher on top, specs and button under it. */
    .bar {
      grid-template-columns: 1fr auto;
    }
    .switch {
      grid-column: 1 / -1;
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      overflow-x: auto;
    }
    .switch button {
      flex: 1;
      padding: var(--s-2) var(--s-3) var(--s-2) var(--s-2);
    }
    .spec {
      grid-template-columns: repeat(2, auto);
    }
    .spec-role {
      display: none !important;
    }
    .go {
      padding: var(--s-3) var(--s-4);
    }

    .work {
      padding-top: var(--s-4);
      padding-bottom: var(--s-6);
    }

    .cards {
      grid-template-columns: 1fr;
      row-gap: var(--s-5);
    }
    .card-1,
    .card-2,
    .card-3 {
      grid-column: 1;
    }
    .fill,
    .card-3 .fill {
      height: 62vw;
    }
    .fill-title,
    .card-2 .fill-title {
      font-size: 22vw;
    }

    .meta {
      grid-template-columns: auto 1fr;
    }
    .summary {
      grid-column: 1 / -1;
      justify-self: start;
      text-align: left;
    }

    .statement {
      width: 100%;
      margin: var(--s-5) 0 var(--s-6);
    }

    .about-grid,
    .reviews ul {
      grid-template-columns: 1fr;
    }
    .philosophy,
    .stats,
    .reviews li:nth-child(n) {
      grid-column: 1;
    }
    .stats {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-3);
    }
    .stats dd {
      font-size: 13vw;
    }
  }
</style>
