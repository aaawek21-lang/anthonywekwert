---
// Not found, in the tasteskill system (Kit layout).
import Kit from '../layouts/Kit.astro';
---

<Kit title="Page not found: Anthony Wekwert" description="This page doesn't exist. The work and the about page are one click away.">
  <section class="section" data-enter aria-labelledby="lost-h">
    <div class="wrap">
      <div class="section-head">
        <h1 id="lost-h">This page doesn't exist</h1>
        <p>The link might be old, or the address has a typo.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--secondary" href="/work">See the work list</a>
        <a class="link" href="/about">Read about me</a>
      </div>
    </div>
  </section>
  <Fragment slot="close">
    <div class="closing__cta close--type">
      <div class="section-head"><h2 id="close-h">Back to the home page</h2></div>
      <a class="btn btn--primary btn--xl" href="/">Go to the home page</a>
    </div>
  </Fragment>
</Kit>
