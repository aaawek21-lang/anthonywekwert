---
// The work list in the tasteskill system (Kit layout): the React Bits portfolio template's two-column
// grid of project cards, each linked to its page (the card lifts 2px and its picture zooms 1.03 on hover).
import Kit from '../../layouts/Kit.astro';
import { projects } from '../../data/projects';
import { workImage } from '../../lib/images';
import { pic } from '../../lib/pic';

const cards = await Promise.all(
  projects.map(async (p) => ({ p, img: p.image ? await pic(workImage(p.image), [480, 800, 1200]) : null })),
);
---

<Kit title="Work: Anthony Wekwert, designer and art director" description="Vita Lenta, Twisted Toonz, Lumina and a year of design studies and photographs by Anthony Wekwert, Michigan State.">
  <style is:inline slot="head">
    /* page CSS: a card without a cover yet shows its title on the panel, the same size as a photograph */
    .tile__media .no-cover { position: absolute; inset: 0; display: flex; align-items: flex-end; }
    .tile__media .no-cover span { font: var(--display-weight) clamp(48px, 6vw, 88px)/.86 var(--font-display); letter-spacing: -0.04em; margin: 0 0 -0.1em var(--s-5); white-space: nowrap; }
    /* the tablet: square pictures, so each screen of two cards is filled */
    @media (min-width: 640px) and (max-width: 1023px) { .tile--wide { --tile-ratio: 1; } }
    @media (min-width: 640px) and (max-width: 1023px) and (min-height: 1100px) { .tile--wide { --tile-ratio: 4 / 5; } }
    /* a phone: two cards and the heading on the first screen; each project's line is the first thing on its own page */
    @media (max-width: 639px) { .tile--wide > p { display: none; } }
  </style>

  <section class="hero" data-enter aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head">
        <h1 id="work-h">Work</h1>
        <p>Three spec projects and a year of design studies and photographs.</p>
      </div>
      <div class="grid">
        {cards.slice(0, 2).map(({ p, img }) => (
          <a class="tile tile--wide span-6" href={`/work/${p.slug}`}>
            <div class="tile__media">
              {img ? (
                <img src={img.src} srcset={img.srcset} sizes="(max-width: 639px) 100vw, 45vw" width={img.width} height={img.height} alt={p.imageAlt} fetchpriority="high" data-source="client" data-subject={`${p.title} project`} />
              ) : (
                <div class="no-cover" aria-hidden="true"><span>{p.title}</span></div>
              )}
            </div>
            <div class="tile__head"><h2 class="t-card">{p.title}</h2><span class="tile__price muted">{p.discipline}</span></div>
            <p>{p.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="more-work" aria-labelledby="more-h">
    <div class="wrap">
      <div class="section-head"><h2 id="more-h">A map and the studies</h2></div>
      <div class="grid">
        {cards.slice(2).map(({ p, img }) => (
          <a class="tile tile--wide span-6" href={`/work/${p.slug}`}>
            <div class="tile__media">
              {img ? (
                <img src={img.src} srcset={img.srcset} sizes="(max-width: 639px) 100vw, 45vw" width={img.width} height={img.height} alt={p.imageAlt} loading="lazy" decoding="async" data-source="client" data-subject={`${p.title} project`} />
              ) : (
                <div class="no-cover" aria-hidden="true"><span>{p.title}</span></div>
              )}
            </div>
            <div class="tile__head"><h3 class="t-card">{p.title}</h3><span class="tile__price muted">{p.discipline}</span></div>
            <p>{p.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Fragment slot="close">
    <div class="closing__cta close--type">
      <div class="section-head">
        <h2 id="close-h">Full-time roles from May 2027</h2>
        <p>Looking for a design or art direction job after graduation.</p>
      </div>
      <a class="btn btn--primary btn--xl" href="/about">Read about me<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
    </div>
  </Fragment>
</Kit>
