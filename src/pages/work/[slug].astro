---
// A project page in the tasteskill system (Kit layout): the split hero (the project, its line, the facts,
// the cover), then its images in the React Bits portfolio template's even two-column grid, four to a
// section so each section stays two screens. Images sit whole on a panel (posters and logos are never cropped).
import Kit from '../../layouts/Kit.astro';
import { projects, type Project, type Shot } from '../../data/projects';
import { workImage } from '../../lib/images';
import { pic } from '../../lib/pic';

export function getStaticPaths() {
  return projects.map((project, i) => ({ params: { slug: project.slug }, props: { project, index: i } }));
}

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const next = projects[(index + 1) % projects.length]!;

// Section headings for each group of four images.
const TITLES: Record<string, string[]> = {
  'vita-lenta': ['Brand slides'],
  'twisted-toonz': ['Cans and labels'],
  'design-studies': ['Logos, posters and flyers', 'Photographs', 'A study and more photographs'],
};
const groups: { title: string; ratio: string; shots: (Shot & { img: Awaited<ReturnType<typeof pic>> })[] }[] = [];
for (let g = 0; g * 4 < project.gallery.length; g++) {
  const shots = await Promise.all(
    project.gallery.slice(g * 4, g * 4 + 4).map(async (s) => ({ ...s, img: await pic(workImage(s.src), [480, 800, 1200]) })),
  );
  // panels follow the group's pictures: 4:3 for mostly wide ones (slides, cans), square for tall ones (posters, photos)
  const wide = shots.reduce((n, s) => n + (s.img.width / s.img.height > 1.2 ? 1 : 0), 0) > shots.length / 2;
  groups.push({ title: (TITLES[project.slug] || [])[g] || 'More images', shots, ratio: wide ? '4 / 3' : '1' });
}

const cover = project.image ? await pic(workImage(project.image), [640, 960, 1280, 1600, 1800]) : null;
const facts = [
  ['Made at', project.context],
  ['Tools', project.tools],
  ['Year', project.year],
].filter(([, v]) => v);
---

<Kit title={`${project.title}: ${project.kind.toLowerCase()} by Anthony Wekwert`} description={`${project.title}, ${project.kind.toLowerCase()}. ${project.summary}`}>
  <style is:inline slot="head">
    /* page CSS: the image grid (two columns, every image whole on its panel) and the cover-less hero block */
    .shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); }
    /* the panel keeps its square; the image is pinned inside it, whole (a tall poster never stretches the panel) */
    .shot { position: relative; margin: 0; aspect-ratio: var(--shot-r, 1); min-height: 0; border-radius: var(--r-lg); background: var(--surface); overflow: clip; }
    .shot > img { position: absolute; inset: var(--s-5); width: calc(100% - 2 * var(--s-5)); height: calc(100% - 2 * var(--s-5)); object-fit: contain; }
    .no-cover { width: 100%; height: 100%; min-width: 0; display: flex; align-items: flex-end; border-radius: var(--r-lg); background: var(--surface); overflow: clip; }
    .no-cover span { font: var(--display-weight) clamp(44px, 7vw, 112px)/.9 var(--font-display); letter-spacing: -0.04em; margin: 0 var(--s-5) var(--s-5); overflow-wrap: anywhere; }
    /* the tablet holds a group of four on one screen */
    .shots-section { --h: 2; }
    .shots[data-shape="wide"] { --shot-r: 4 / 3; }
    @media (min-width: 1024px) and (max-width: 1279px) { .shots[data-shape="wide"] { --shot-r: 1; } }
    @media (min-width: 640px) and (max-width: 1023px) { .shots-section { --h: 1; } }
    .hero-facts-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); margin: 0; }
    .hero-facts-list dt { color: var(--muted); font-size: var(--t-small); }
    .hero-facts-list dd { margin: 0; }
    @media (max-width: 639px) { .shots { grid-template-columns: 1fr; gap: var(--s-4); } .shot { aspect-ratio: 4 / 3; } .shot > img { inset: var(--s-4); width: calc(100% - 2 * var(--s-4)); height: calc(100% - 2 * var(--s-4)); } }
  </style>

  <section class="hero hero--split" data-enter aria-labelledby="hero-h">
    <div class="wrap"><div class="hero-text grid hero__grid">
      <div class="hero__text span-5">
        <p class="hero__kicker"><span class="dot" aria-hidden="true"></span>{project.kind}</p>
        <h1 id="hero-h">{project.title}</h1>
        <p class="hero__lead">{project.summary}</p>
        {facts.length > 0 && (
          <dl class="hero-facts-list">
            {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
          </dl>
        )}
        <div class="btn-row">
          {groups.length > 0 && <a class="btn btn--secondary" href="#images">See the images</a>}
          <a class="link" href={`/work/${next.slug}`}>Next: {next.title}</a>
        </div>
      </div>
      <div class="hero__media span-6 start-7">
        {cover ? (
          <img src={cover.src} srcset={cover.srcset} sizes="(max-width: 1023px) 100vw, 66vw" width={cover.width} height={cover.height} alt={project.imageAlt} fetchpriority="high" data-source="client" data-subject={`${project.title} project`} />
        ) : (
          <div class="no-cover" aria-hidden="true"><span>{project.title}</span></div>
        )}
      </div>
    </div></div>
  </section>

  {groups.map((g, gi) => (
    <section class="section shots-section" id={gi === 0 ? 'images' : `images-${gi + 1}`} aria-labelledby={`images-h-${gi}`}>
      <div class="wrap">
        <div class="section-head"><h2 id={`images-h-${gi}`}>{g.title}</h2></div>
        <div class="shots" data-shape={g.ratio === '1' ? 'tall' : 'wide'}>
          {g.shots.map((s) => (
            <figure class="shot">
              <img src={s.img.src} srcset={s.img.srcset} sizes="(max-width: 639px) 90vw, 45vw" width={s.img.width} height={s.img.height} alt={s.alt} loading="lazy" decoding="async" data-source="client" data-subject={`${project.title} image`} />
            </figure>
          ))}
        </div>
      </div>
    </section>
  ))}

  <Fragment slot="close">
    <div class="closing__cta close--type">
      <div class="section-head">
        <h2 id="close-h">Next project: {next.title}</h2>
        <p>{next.summary}</p>
      </div>
      <a class="btn btn--primary btn--xl" href={`/work/${next.slug}`}>See {next.title}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
    </div>
  </Fragment>
</Kit>
